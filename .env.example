# Database
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/lead_generator

# Session security (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_this_to_a_random_secret_key

# Environment
APP_ENV=development
DEBUG=true

# Google Places API (Phase 1)
GOOGLE_PLACES_API_KEY=your_api_key_here

# Gemini API (Phase 4)
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Pipeline safety limits (Phase 2)
MAX_PLACES_PER_RUN=60
PIPELINE_RUN_TIMEOUT_SECONDS=300

# Lead scoring weights (Phase 2) — max points per signal (must sum to 100)
SCORE_WEIGHT_NO_WEBSITE=35
SCORE_WEIGHT_RATING=25
SCORE_WEIGHT_NO_AUTOMATION=15
SCORE_WEIGHT_OUTDATED_SITE=25
SCORE_RATING_MIN_REVIEWS=20
SCORE_RATING_GOOD_THRESHOLD=4.0
